# Copy this file to .env. Keep real credentials out of Git.
AUTOFORGE_PORT=4317
AUTOFORGE_REPOSITORY=https://github.com/flexda/dev-auto-test
AUTOFORGE_MODEL=openai/gpt-6-luna-fast
# AI inference: required for AI runs (built-in example does not use AI).
AI_GATEWAY_API_KEY=
# Public repositories work without a token. Private repositories need read access.
GITHUB_TOKEN=
# Optional static Vercel Preview deployment.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Start Docker Desktop before AI runs. Pre-pull the image if needed.
SANDBOX_IMAGE=node:24-alpine
